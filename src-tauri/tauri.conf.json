{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Borg.Box",
  "version": "1.0.317",
  "identifier": "space.borgbox.desktop",
  "build": {
    "frontendDist": "../Borg.Box"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Borg.Box - Mods Manager",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "maximizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
